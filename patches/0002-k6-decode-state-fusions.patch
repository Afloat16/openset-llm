+        const float * q_d = (const float *) ((const char *) src_q->data + iq1 * src_q->nb[1]);
+        const float * k_d = (const float *) ((const char *) src_k->data + ik1 * src_k->nb[1]);
+        const float * v_d = (const float *) ((const char *) src_v->data + iv1 * src_v->nb[1]);
+        float beta_val = *(const float *) ((const char *) src_beta->data + iv1 * src_beta->nb[1]);
+        const float * g_d = (const float *) ((const char *) src_g->data + iv1 * src_g->nb[1]);
