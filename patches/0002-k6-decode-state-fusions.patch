+            const float eg = kda ? 0.0f : expf(g0);
+            if (kda) for (int64_t i = 0; i < S_v; ++i) delta[i] = expf(g_d[i]);
+            for (int64_t j = 0; j < S_v; ++j) {
+                float * row = &s_out[j * S_v];
+                if (kda) ggml_vec_mul_f32(S_v, row, row, delta); else ggml_vec_scale_f32(S_v, row, eg);
