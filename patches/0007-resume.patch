+    // 0007: write the prefix state; called when the prefill stands exactly at the prefix end
+    void rsm_save_prefix(server_slot & slot) {
+        const int32_t p = slot.rsm_prefix;
+        slot.rsm_prefix = -1;
+        const auto & in = slot.task->tokens;
+        llama_tokens pre(in.get_tokens().begin(), in.get_tokens().begin() + p);
+        const uint64_t h = rsm_hash(pre);
+        const int64_t t0 = ggml_time_us();
+        size_t bytes = 0;
+        bool ok = true;
+        std::error_code ec;
+        const std::string ft = rsm_path(h, "tgt");
+        const std::string tmp_t = ft + ".tmp";
+        bytes += llama_state_seq_save_file(ctx_tgt, tmp_t.c_str(), slot.id, pre.data(), pre.size());
+        rsm_drop_cache(tmp_t);
+        if (ctx_dft) {
+            const std::string fd = rsm_path(h, "dft");
+            bytes += llama_state_seq_save_file(ctx_dft, fd.c_str(), slot.id, pre.data(), pre.size());
+            rsm_drop_cache(fd);
+        }
+        std::vector<uint8_t> sp;
+        if (common_speculative_get_state(spec.get(), slot.id, sp)) {
+            std::ofstream f(rsm_path(h, "spec"), std::ios::binary);
+            f.write((const char *) sp.data(), sp.size());
+            ok = (bool) f;
+            bytes += sp.size();
+        } else {
+            std::filesystem::remove(rsm_path(h, "spec"), ec);
+        }
+        if (ok) {
+            std::filesystem::rename(tmp_t, ft, ec);   // the .tgt file appears last: it marks a complete set
+            ok = !ec;
+        }
+        SLT_INF(slot, "resume: %s the %d-token prefix state (%.1f MiB) in %.2f s\n", ok ? "wrote" : "FAILED to write", p,
+                bytes / 1024.0 / 1024.0, (ggml_time_us() - t0) / 1e6);
+        rsm_prune();
+    }
