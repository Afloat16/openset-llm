+    // 0007: called when a completion task starts, after n_past (the common prefix with the cache) is known
+    void rsm_task_start(server_slot & slot, int32_t & n_past) {
+        const auto & in = slot.task->tokens;
+        const int32_t n_old = slot.prompt.n_tokens();
+        const int32_t n_new = slot.task->n_tokens();
+
+        // (a) learn: the request diverged from the cache inside the previous prompt -> remember the old tokens there
+        if (slot.task->params.cache_prompt && n_past > 0 && n_past < slot.rsm_prev_n_prompt && n_past + 1 + RSM_SIG_LEN <= n_old) {
+            // the token at the divergence often merges with the whitespace before it (' \\n\\n', '\\t\\n\\n', ...), so the
+            // signature is the RSM_SIG_LEN tokens after it, and the resume point is the token before a match
+            llama_tokens sig;
+            for (int i = 1; i <= RSM_SIG_LEN; i++) { sig.push_back(slot.prompt.tokens[n_past + i]); }
+            if (std::none_of(sig.begin(), sig.end(), [](llama_token t) { return t == LLAMA_TOKEN_NULL; })) {
+                auto it = std::find_if(rsm.sigs.begin(), rsm.sigs.end(), [&](const rsm_sig & s) { return s.toks == sig; });
+                const bool fresh = it == rsm.sigs.end();
+                if (fresh) {
+                    if ((int) rsm.sigs.size() >= RSM_MAX_SIGS) {
+                        rsm.sigs.erase(std::min_element(rsm.sigs.begin(), rsm.sigs.end(),
+                                [](const rsm_sig & a, const rsm_sig & b) { return a.used < b.used; }));
+                    }
+                    rsm.sigs.push_back({ sig, ++rsm.clock });
+                } else {
+                    it->used = ++rsm.clock;
+                }
+                std::string txt;
+                txt = "[" + common_token_to_piece(ctx_tgt, slot.prompt.tokens[n_past]) + "]";
+                for (llama_token t : sig) { txt += common_token_to_piece(ctx_tgt, t); }
+                string_replace_all(txt, "\n", "\\n");
+                SLT_INF(slot, "resume: diverged at %d of %d cached tokens (previous prompt %d), %s signature '%s'\n",
+                        n_past, n_old, slot.rsm_prev_n_prompt, fresh ? "learned" : "seen", txt.c_str());
+            }
+        }
+
+        // (b) predicted resume points: the last occurrence of each signature in the part still to be read
+        slot.rsm_points.clear();
+        for (const auto & s : rsm.sigs) {
+            for (int32_t q = n_new - RSM_SIG_LEN - 1; q - 1 > n_past; q--) {
+                bool m = true;
+                for (int i = 0; i < RSM_SIG_LEN && m; i++) { m = in[q + i] == s.toks[i]; }
+                if (m) { slot.rsm_points.push_back(q - 1); break; }
+            }
