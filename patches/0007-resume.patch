+            slot.rsm_prefix = p;
+            n_past = 0;
+            return false;
+        }
+        slot.prompt.clear();   // the cache now holds exactly the prefix; old checkpoints belonged to another conversation
+        for (llama_token t : pre) { slot.prompt.tokens.push_back(t); }
