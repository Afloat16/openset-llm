+// ---- openset-llm 0007 resume: checkpoint where the next request will resume -------------------------------------------
+// LLAMA_RESUME=0 turns all of it off (the server then behaves exactly as with 0006 alone).
+//  (a) when a request diverges from the cached tokens inside the previous prompt (a client that rewrites its tail,
+//      e.g. a <system-reminder> it strips and re-appends), the RSM_SIG_LEN tokens the old prompt had at the
+//      divergence are remembered. While reading later prompts the batch is cut at the last occurrence of each such
+//      signature and a checkpoint is made there, so the next request resumes at its divergence, not a message earlier.
+//  (b) the --ctx-checkpoints N pool is cost-aware: a checkpoint is worth (prompt tokens it saves) x (observed resume
+//      rate of its kind); when the pool is full the least valuable one goes, and a new one worth less than all kept
+//      ones is not made. Same bytes per checkpoint, so this is FlashState's "prefill saved per byte".
+//  (c) LLAMA_RESUME_DIR=<dir>: the full state (attention KV + recurrent + draft) at the end of the system(+tools)
+//      prefix is written once per distinct prefix (token hash) and loaded by any request whose cache does not cover it
+//      (a new conversation, another slot's conversation, a restarted server). LLAMA_RESUME_DIR_MAX files (default 8).
+#include <fcntl.h>
+#if defined(__linux__) || defined(__APPLE__)
+#include <unistd.h>
+#endif
+
+enum rsm_kind { RSM_OTHER = 0, RSM_USER, RSM_END_UB, RSM_END4, RSM_SIG, RSM_N_KINDS };
+static const char * rsm_kind_name(int k) {
+    static const char * n[] = { "other", "msg-start", "end-ub", "end-4", "signature" };
+    return k >= 0 && k < RSM_N_KINDS ? n[k] : "?";
+}
+static constexpr int RSM_SIG_LEN  = 4;
+static constexpr int RSM_MAX_SIGS = 4;
+struct rsm_sig { llama_tokens toks; int64_t used = 0; };
+static struct {
+    int on = -1;
+    std::string dir;
+    int max_files = 8;
+    std::vector<rsm_sig> sigs;
+    int64_t clock = 0;
+    double hits[RSM_N_KINDS]  = { 0 };
+    double tries[RSM_N_KINDS] = { 0 };
+} rsm;
+static bool rsm_on() {
+    if (rsm.on < 0) {
+        const char * e = getenv("LLAMA_RESUME");
+        rsm.on = !(e && atoi(e) == 0);
+        const char * d = getenv("LLAMA_RESUME_DIR");
+        if (rsm.on && d && *d) {
+            std::error_code ec;
+            std::filesystem::create_directories(d, ec);
+            if (!ec) { rsm.dir = d; }
+        }
+        const char * m = getenv("LLAMA_RESUME_DIR_MAX");
+        if (m) { rsm.max_files = std::max(1, atoi(m)); }
+    }
+    return rsm.on == 1;
+}
+// resume rate of a kind: observed (hits, tries) plus a prior worth 2 tries
+static double rsm_rate(int k) {
+    static const double prior[RSM_N_KINDS] = { 0.2, 0.5, 0.3, 0.5, 0.9 };
+    return (rsm.hits[k] + 2.0 * prior[k]) / (rsm.tries[k] + 2.0);
+}
+static double rsm_value(int kind, int64_t n_tokens) { return rsm_rate(kind) * (double) n_tokens; }
+static uint64_t rsm_env_hash = 0;   // the environment key below, set once at the first prefix lookup
+static uint64_t rsm_hash(const llama_tokens & t) {
+    uint64_t h = 1469598103934665603ULL;
+    for (llama_token x : t) { h ^= (uint32_t) x; h *= 1099511628211ULL; }
+    return (h ^ (uint64_t) t.size()) * 31 + rsm_env_hash;   // the file name keys the tokens AND the environment
+}
+// what else a saved state depends on: the model file (path, size, FNV of its first MiB), this binary (size + mtime of
+// /proc/self/exe: any patch or kernel change rebuilds it), KV types, flash-attention mode, whether a draft context
+// exists, and every GGML_* / LLAMA_* / X1_* environment variable (kernel modes, X1/X2 switches), LLAMA_RESUME* excepted
+static uint64_t rsm_fnv(uint64_t h, const void * p, size_t n) {
+    const uint8_t * b = (const uint8_t *) p;
+    for (size_t i = 0; i < n; i++) { h ^= b[i]; h *= 1099511628211ULL; }
+    return h;
+}
+#if !defined(_WIN32)
+extern char ** environ;
+#endif
+static std::string rsm_env_desc(const std::string & model_path, int type_k, int type_v, int fa, bool has_dft) {
+    std::error_code ec;
+    std::string d = "model=" + model_path + " size=" + std::to_string((unsigned long long) std::filesystem::file_size(model_path, ec));
+    {
+        std::ifstream f(model_path, std::ios::binary);
+        std::vector<char> head(1 << 20);
+        f.read(head.data(), head.size());
+        char b[32];
+        snprintf(b, sizeof(b), "%016llx", (unsigned long long) rsm_fnv(1469598103934665603ULL, head.data(), (size_t) f.gcount()));
+        d += std::string(" head=") + b;
+    }
+#if defined(__linux__)
+    {
+        const auto exe = std::filesystem::read_symlink("/proc/self/exe", ec);
+        const auto sz  = std::filesystem::file_size(exe, ec);
+        const auto mt  = std::filesystem::last_write_time(exe, ec).time_since_epoch().count();
+        d += " exe=" + std::to_string((unsigned long long) sz) + "@" + std::to_string((long long) mt);
+    }
+#endif
+    d += " ctk=" + std::to_string(type_k) + " ctv=" + std::to_string(type_v) + " fa=" + std::to_string(fa) + " dft=" + std::to_string(has_dft ? 1 : 0);
+    std::vector<std::string> env;
+#if !defined(_WIN32)
+    for (char ** e = environ; e && *e; e++) {
+        const std::string kv = *e;
+        if ((kv.rfind("GGML_", 0) == 0 || kv.rfind("LLAMA_", 0) == 0 || kv.rfind("X1_", 0) == 0) && kv.rfind("LLAMA_RESUME", 0) != 0) {
+            env.push_back(kv);
+        }
+    }
+#endif
+    std::sort(env.begin(), env.end());
+    for (const auto & kv : env) { d += " " + kv; }
+    return d;
+}
+static std::string rsm_path(uint64_t h, const char * part) {
+    char b[64];
+    snprintf(b, sizeof(b), "/prefix-%016llx.%s", (unsigned long long) h, part);
+    return rsm.dir + b;
+}
+// a state written on an 8 GB box must not stay in the page cache (it would push out the model's hot file pages)
+static void rsm_drop_cache(const std::string & path) {
+#if defined(__linux__)
+    int fd = open(path.c_str(), O_RDONLY);
+    if (fd >= 0) { fdatasync(fd); posix_fadvise(fd, 0, 0, POSIX_FADV_DONTNEED); close(fd); }
+#else
+    (void) path;
+#endif
+}
+static void rsm_prune() {
+    std::error_code ec;
+    std::vector<std::pair<std::filesystem::file_time_type, std::filesystem::path>> v;
+    for (const auto & e : std::filesystem::directory_iterator(rsm.dir, ec)) {
+        const auto name = e.path().filename().string();
+        if (name.rfind("prefix-", 0) == 0 && e.path().extension() == ".tgt") {
+            v.emplace_back(std::filesystem::last_write_time(e.path(), ec), e.path());
+        }
+    }
+    if ((int) v.size() <= rsm.max_files) { return; }
+    std::sort(v.begin(), v.end());
+    for (size_t i = 0; i + rsm.max_files < v.size(); i++) {
+        auto p = v[i].second;
+        for (const char * ext : { ".tgt", ".dft", ".spec" }) { p.replace_extension(ext); std::filesystem::remove(p, ec); }
+    }
+}
+static bool rsm_read_bytes(const std::string & path, std::vector<uint8_t> & out) {
+    std::ifstream f(path, std::ios::binary);
+    if (!f) { return false; }
+    out.assign(std::istreambuf_iterator<char>(f), std::istreambuf_iterator<char>());
+    return true;
+}
