+            std::filesystem::last_write_time(ft, std::filesystem::file_time_type::clock::now(), ec);
+        }
+        if (!ok) {
+            SLT_WRN(slot, "resume: could not load the prefix state %s (removed; it is written again); reading the prompt from token 0\n", ft.c_str());
+            for (const char * ext : { "tgt", "dft", "spec" }) { std::filesystem::remove(rsm_path(h, ext), ec); }
+            slot.mem.seq_rm(slot.id, -1, -1);
