+        slot.rsm_points.erase(std::unique(slot.rsm_points.begin(), slot.rsm_points.end()), slot.rsm_points.end());
+        if (!slot.rsm_points.empty()) {
+            std::string pts;
+            for (auto q : slot.rsm_points) { pts += " " + std::to_string(q); }
