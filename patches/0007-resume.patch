+        std::error_code ec;
+        if (!std::filesystem::exists(ft, ec)) {
+            slot.rsm_prefix = p;   // write it when the prefill reaches p
+            return false;
+        }
+        const int64_t t0 = ggml_time_us();
+        slot.mem.seq_rm(slot.id, -1, -1);
+        llama_tokens got(p);
+        size_t n_got = 0;
+        bool ok = llama_state_seq_load_file(ctx_tgt, ft.c_str(), slot.id, got.data(), got.size(), &n_got) > 0 && n_got == (size_t) p && got == pre;
+        if (ok && ctx_dft) {
