+// X2 bit 32: the multi-stream decode's ternary matmuls (M = 2..4 activation columns, one per
+// sequence) through TWO panels per core at once -- K5's two-stream trick (ptq1v_panel_np) applied to ptq1v_panel's
+// NT-token loop. At M = 4 a 512-byte unit costs ~171 port-0 uops (38 vpdpbusd + flushes per token), about the same time
+// as streaming it from DRAM, so the decode window holds few lines in flight; a second panel doubles them.
+// Numerics: per (panel, token) the int32 block sums are exact whatever the chain count, and every block's
+// fmadd(cvt(sum), dxv * dy) into the float accumulator runs in block order from 0 with the same operands as
+// ptq1v_panel, so each column is bit-identical to ptq1v_gemm_m and to the M = 1 kernels.
+// Included into ggml-cpu.c after ptq1-fast.inc by apply_x2.py (needs PTQ1V_OK).
+#if defined(PTQ1V_OK) && PTQ1V_OK
+#ifndef X2_PF
+#define X2_PF 2048
+#endif
+static inline __attribute__((always_inline)) void x2_panel2_nt(
+        const ptq1p_entry * e, const uint8_t * panel, const uint8_t * acts, size_t cb, const int NT, const int PF,
+        float * dst, int64_t ld, int64_t row0) {
+    enum { NP = 2 };
+    const int64_t kpad = e->kpad;
+    const int8_t * q[4]; const float * dy[4]; const int32_t * as[4];
+    for (int t = 0; t < NT; ++t) {
+        const uint8_t * base = acts + (size_t) t * cb;
+        q[t] = (const int8_t *) base; dy[t] = (const float *) (base + kpad); as[t] = (const int32_t *) (dy[t] + kpad / 32);
+    }
+    const ggml_half * sc[NP]; const uint8_t * P[NP];
+    for (int p = 0; p < NP; ++p) { P[p] = panel + p * e->panel_stride; sc[p] = (const ggml_half *) (P[p] + ptq1v_data_bytes(e)); }
+    const __m512i ctrlA = _mm512_load_si512(ptq1v_tab[0]), ctrlC = _mm512_load_si512(ptq1v_tab[1]), ctrlD = _mm512_load_si512(ptq1v_tab[2]);
+    const __m512i l30 = _mm512_load_si512(ptq1v_tab[3]), l31 = _mm512_load_si512(ptq1v_tab[4]), l32 = _mm512_load_si512(ptq1v_tab[5]);
+    const __m512i l20 = _mm512_load_si512(ptq1v_tab[6]), l21 = _mm512_load_si512(ptq1v_tab[7]);
+    const __m512i g0 = _mm512_load_si512(ptq1v_tab[8]), gC = _mm512_load_si512(ptq1v_tab[9]), gD = _mm512_load_si512(ptq1v_tab[10]);
+    __m512 accf[NP][4], dxv[NP]; __m512i acci[NP][4];
+    for (int p = 0; p < NP; ++p) {
+        dxv[p] = _mm512_setzero_ps();
+        for (int t = 0; t < NT; ++t) { accf[p][t] = _mm512_setzero_ps(); acci[p][t] = _mm512_set1_epi32(as[t][0]); }
+    }
+    int64_t b0 = 0, s0 = 0;
+#define X2_STEP(s, CODES) do {                                                                                \
+        const __m512i c0_ = CODES(0), c1_ = CODES(1);                                                         \
+        for (int t = 0; t < NT; ++t) {                                                                        \
+            const __m512i bq_ = _mm512_set1_epi32(*(const int32_t *) (q[t] + 4 * (s0 + (s))));                \
+            acci[0][t] = _mm512_dpbusd_epi32(acci[0][t], c0_, bq_);                                           \
+            acci[1][t] = _mm512_dpbusd_epi32(acci[1][t], c1_, bq_);                                           \
+        }                                                                                                     \
+        if ((s) % 8 == 7) {                                                                                   \
+            const int64_t b = b0 + (s) / 8;                                                                   \
+            for (int p = 0; p < NP; ++p) {                                                                    \
+                if ((b & 3) == 0) dxv[p] = _mm512_cvtph_ps(_mm256_loadu_si256((const __m256i *) (sc[p] + (b >> 2) * PTQ1P_ROWS))); \
+                for (int t = 0; t < NT; ++t) {                                                                \
+                    accf[p][t] = _mm512_fmadd_ps(_mm512_cvtepi32_ps(acci[p][t]), _mm512_mul_ps(dxv[p], _mm512_set1_ps(dy[t][b])), accf[p][t]); \
+                    acci[p][t] = _mm512_set1_epi32(as[t][b + 1]);                                             \
+                }                                                                                             \
+            }                                                                                                 \
+        } } while (0)
+#define X2_A(p) _mm512_permutexvar_epi8(A[p], L)
+#define X2_B(p) _mm512_permutexvar_epi8(B[p], L)
+#define X2_E(p) _mm512_permutexvar_epi8(E[p], L)
+#define X2_T(p) _mm512_permutexvar_epi8(T[p], L)
+#define X2_PAIR(off, sl, pp, TAIL) do {                                                                       \
+        __m512i A[NP], B[NP], E[NP];                                                                          \
+        for (int p = 0; p < NP; ++p) {                                                                        \
+            if (PF) { _mm_prefetch((const char *) (P[p] + (off) + PF), _MM_HINT_T0); _mm_prefetch((const char *) (P[p] + (off) + PF + 64), _MM_HINT_T0); } \
+            const __m512i c0 = _mm512_loadu_si512((const void *) (P[p] + (off)));                             \
+            const __m512i c1 = _mm512_loadu_si512((const void *) (P[p] + (off) + 64));                        \
+            A[p] = _mm512_multishift_epi64_epi8(ctrlA, c0); B[p] = _mm512_multishift_epi64_epi8(ctrlA, c1);   \
+            const __m512i C = _mm512_multishift_epi64_epi8(ctrlC, c0), D = _mm512_multishift_epi64_epi8(ctrlD, c1); \
+            E[p] = _mm512_mask_blend_epi32((__mmask16) 0xAAAA, C, D);                                         \
+            if (TAIL) {                                                                                       \
+                if ((pp) == 0) T[p] = _mm512_permutex2var_epi8(C, g0, D);                                     \
+                else {                                                                                        \
+                    T[p] = _mm512_mask_permutex2var_epi8(T[p], (__mmask64) 0xFFu << (16 * (pp)), gC, C);      \
+                    T[p] = _mm512_mask_permutex2var_epi8(T[p], (__mmask64) 0xFFu << (16 * (pp) + 8), gD, D);  \
+                }                                                                                             \
+            }                                                                                                 \
+        }                                                                                                     \
+        { const __m512i L = l30; X2_STEP((sl) + 0, X2_A); }                                                   \
+        { const __m512i L = l31; X2_STEP((sl) + 1, X2_A); }                                                   \
+        { const __m512i L = l32; X2_STEP((sl) + 2, X2_A); }                                                   \
+        { const __m512i L = l30; X2_STEP((sl) + 3, X2_B); }                                                   \
+        { const __m512i L = l31; X2_STEP((sl) + 4, X2_B); }                                                   \
+        { const __m512i L = l32; X2_STEP((sl) + 5, X2_B); }                                                   \
+        { const __m512i L = l30; X2_STEP((sl) + 6, X2_E); }                                                   \
+        { const __m512i L = l31; X2_STEP((sl) + 7, X2_E); }                                                   \
+        { const __m512i L = l32; X2_STEP((sl) + 8, X2_E); }                                                   \
+        } while (0)
+    for (int64_t sb = 0; sb < e->nsb; ++sb, b0 += PTQ1V_STEPS / 8, s0 += PTQ1V_STEPS) {
+#pragma GCC unroll 4
+        for (int u = 0; u < 4; ++u) {
+            __m512i T[NP];
+            for (int p = 0; p < NP; ++p) T[p] = _mm512_setzero_si512();
+#pragma GCC unroll 4
+            for (int pp = 0; pp < 4; ++pp) X2_PAIR(u * 512 + pp * 128, u * 38 + pp * 9, pp, 1);
+            { const __m512i L = l20; X2_STEP(u * 38 + 36, X2_T); }
+            { const __m512i L = l21; X2_STEP(u * 38 + 37, X2_T); }
+        }
+        for (int p = 0; p < NP; ++p) P[p] += PTQ1V_SBB;
+    }
+    for (int64_t sb = 0; sb < e->n36; ++sb, b0 += PTQ1W_STEPS / 8, s0 += PTQ1W_STEPS) {
+        __m512i T[NP]; (void) T;
+#pragma GCC unroll 8
+        for (int pp = 0; pp < 8; ++pp) X2_PAIR(pp * 128, pp * 9, pp, 0);
+        for (int p = 0; p < NP; ++p) P[p] += PTQ1W_SBB;
+    }
+#undef X2_PAIR
+#undef X2_STEP
+#undef X2_A
+#undef X2_B
+#undef X2_E
+#undef X2_T
+    for (int p = 0; p < NP; ++p) {
+        const int64_t r0 = row0 + p * PTQ1P_ROWS;
+        const int64_t nr = (e->rows - r0) < PTQ1P_ROWS ? (e->rows - r0) : PTQ1P_ROWS;
+        if (nr <= 0) continue;
+        for (int t = 0; t < NT; ++t) _mm512_mask_storeu_ps(dst + t * ld + r0, (__mmask16) ((1u << nr) - 1), accf[p][t]);
+    }
+}
+// panels [p0, p1) x m tokens (2 <= m <= 4): pairs through x2_panel2_nt, an odd last panel through ptq1v_gemm_m's kernel
+static void x2_panels_m(const ptq1p_entry * e, const uint8_t * acts, size_t cb, int64_t m, int64_t p0, int64_t p1, float * dst, int64_t ld) {
+    int64_t p = p0;
+    for (; p + 2 <= p1; p += 2) {
+        const uint8_t * pan = e->packed + p * e->panel_stride;
+        switch (m) {
+            case 2: x2_panel2_nt(e, pan, acts, cb, 2, X2_PF, dst, ld, p * PTQ1P_ROWS); break;
+            case 3: x2_panel2_nt(e, pan, acts, cb, 3, X2_PF, dst, ld, p * PTQ1P_ROWS); break;
+            default: x2_panel2_nt(e, pan, acts, cb, 4, X2_PF, dst, ld, p * PTQ1P_ROWS); break;
+        }
+    }
+    if (p < p1) ptq1v_gemm_m(e, acts, cb, m, p, p1, dst, ld);
+}
+#endif
+
+// X2 bit 4: a ternary MUL_MAT whose activations are 3D [k, n_seq_tokens, n_seqs] (the Gated-DeltaNet layers' projections
+// when a ubatch holds several sequences) misses ptq1f_applies (it wants ne[2] == 1) and falls back to the fork's kernel.
+// Its src1 and dst are contiguous, so the same call on a flat [k, n_seq_tokens * n_seqs] view is the same product,
+// column by column (the fast kernels are bit-identical per column). Only when the planned work buffer fits.
+static int x2_ptq1_mode = -1;
+static int x2_ptq1_3d(const struct ggml_cgraph * cg, int i, const struct ggml_compute_params * params) {
+    if (x2_ptq1_mode < 0) { const char * e = getenv("GGML_X2"); x2_ptq1_mode = e ? atoi(e) : 0; }
+    if (!(x2_ptq1_mode & 4) || params->use_ref) return -1;
+    struct ggml_tensor * d = cg->nodes[i];
+    if (d->op != GGML_OP_MUL_MAT || d->src[0]->type != GGML_TYPE_PTQ1_0) return -1;
+    const struct ggml_tensor * b = d->src[1];
+    if (b->ne[2] < 2 || b->ne[3] != 1 || d->ne[3] != 1 || !ggml_is_contiguous(b) || !ggml_is_contiguous(d) || b->type != GGML_TYPE_F32) return -1;
+    struct ggml_tensor b2 = *b, d2 = *d;
+    b2.ne[1] = b->ne[1] * b->ne[2]; b2.ne[2] = 1; b2.nb[2] = b2.nb[3] = b2.nb[1] * b2.ne[1];
+    d2.ne[1] = d->ne[1] * d->ne[2]; d2.ne[2] = 1; d2.nb[2] = d2.nb[3] = d2.nb[1] * d2.ne[1];
+    d2.src[1] = &b2;
+    if (!ptq1f_applies(d2.src[0], &b2) || ptq1f_wsize(d2.src[0], &b2) > params->wsize) return -1;
+    return ptq1f_mul_mat(params, &d2) ? 1 : -1;
+}
+
+// X2 bit 32: ternary MUL_MATs of a multi-sequence decode step (2..4 columns, 2D or 3D activations) through x2_panels_m
+// (x2-kernel.inc: two panels per core x all columns). The flow is ptq1p_mul_mat's small (mode 6) path: shared block-range
+// quantize of every column, a barrier, dynamic chunks of panels. Only once the weights are repacked (else -1: the stock
+// call repacks), mode 7, and the planned work buffer fits.
+static __thread const struct ggml_cgraph * x2_cg_last; static __thread int x2_cg_last_i = 1 << 30, x2_cg_multi;
+static void x2_graph_check(const struct ggml_cgraph * cg, int i) {
+    if (cg != x2_cg_last || i < x2_cg_last_i) {   // new graph: is it a multi-sequence one-token-per-sequence step?
+        x2_cg_multi = 0;
+        for (int j = 0; j < cg->n_nodes; ++j) {
+            const struct ggml_tensor * g = cg->nodes[j];
+            if (g->op == GGML_OP_GATED_DELTA_NET) { x2_cg_multi = g->src[2]->ne[2] == 1 && g->src[2]->ne[3] >= 2; break; }
+        }
+    }
+    x2_cg_last = cg; x2_cg_last_i = i;
+}
+static int x2_ptq1_small(const struct ggml_cgraph * cg, int i, const struct ggml_compute_params * params) {
+    if (x2_ptq1_mode < 0) { const char * e = getenv("GGML_X2"); x2_ptq1_mode = e ? atoi(e) : 0; }
+    if (!(x2_ptq1_mode & 32) || params->use_ref) return -1;
+#if defined(PTQ1V_OK) && PTQ1V_OK
+    x2_graph_check(cg, i);
+    struct ggml_tensor * d = cg->nodes[i];
+    if (!x2_cg_multi || d->op != GGML_OP_MUL_MAT || d->src[0]->type != GGML_TYPE_PTQ1_0 || !ptq1p_mode7()) return -1;
+    const struct ggml_tensor * a = d->src[0], * b = d->src[1];
+    const int64_t m = b->ne[1] * b->ne[2], k = a->ne[0];
+    if (m < 2 || m > 4 || b->ne[3] != 1 || b->type != GGML_TYPE_F32 || !ggml_is_contiguous(b) || !ggml_is_contiguous(d) ||
+        a->ne[2] != 1 || a->ne[3] != 1 || !ggml_is_contiguous(a) || k % 128 != 0 || !ptq1f_enabled()) return -1;
+    ptq1p_entry * e = NULL;
+    for (ptq1p_entry * it = __atomic_load_n(&ptq1p_list, __ATOMIC_ACQUIRE); it; it = it->next) if (it->src == a->data) { e = it; break; }
+    if (!e) return -1;
+    const size_t cb = ptq1v_col_bytes(k);
+    if (cb * (size_t) m + 64 > params->wsize) return -1;
+    const int ith = params->ith, nth = params->nth;
+    uint8_t * acts = (uint8_t *) (((uintptr_t) params->wdata + 63) & ~(uintptr_t) 63);
+    ggml_threadpool_chunk_set(params->threadpool, nth);
+    const int64_t nb = k / 32, per = (nb + nth - 1) / nth;
+    for (int64_t t = 0; t < m; ++t) {
+        const float * x = (const float *) ((const char *) b->data + t * b->nb[1]);   // contiguous: column t of the flat view
+        if (ptq1p_k6() & 8) ptq1k6_quantize_part(x, k, e->kpad, acts + t * cb, PTQ1F_MIN(nb, ith * per), PTQ1F_MIN(nb, (ith + 1) * per), 1);
+        else ptq1p_quantize_col_part_kp(x, k, e->kpad, acts + t * cb, PTQ1F_MIN(nb, ith * per), PTQ1F_MIN(nb, (ith + 1) * per), 1);
+    }
+    ggml_barrier(params->threadpool);
+    const int64_t ch = PTQ1F_MIN(8, ((e->npanel + 8 * nth - 1) / (8 * nth) + 1) / 2 * 2);   // even: the panel pairs line up
+    const int64_t nch = (e->npanel + ch - 1) / ch;
+    for (int64_t c = ith; c < nch; c = ggml_threadpool_chunk_add(params->threadpool, 1))
+        x2_panels_m(e, acts, cb, m, c * ch, PTQ1F_MIN(e->npanel, (c + 1) * ch), (float *) d->data, d->nb[1] / sizeof(float));
+    return 1;
+#else
+    (void) cg; (void) i; return -1;
+#endif
+}
+
+// X2 bit 8: in a multi-sequence decode graph (its Gated-DeltaNet nodes have one token for each of >= 2 sequences), a
+// BF16 MUL_MAT (the GDN layers' alpha/beta projections) with 2..8 activation columns would go to llamafile's tinyBLAS
+// (n >= 2), whose float order differs from the n = 1 vec_dot path a single stream takes. Compute every (row, column) with
+// that n = 1 path's own conversion and vec_dot call (so the same values as alone), one barrier in all.
+static int x2_col_mm(const struct ggml_cgraph * cg, int i, const struct ggml_compute_params * params) {
+    if (x2_ptq1_mode < 0) { const char * e = getenv("GGML_X2"); x2_ptq1_mode = e ? atoi(e) : 0; }
+    if (!(x2_ptq1_mode & 8) || params->use_ref) return -1;
+    x2_graph_check(cg, i);
+    struct ggml_tensor * d = cg->nodes[i];
+    if (!x2_cg_multi || d->op != GGML_OP_MUL_MAT || d->src[0]->type != GGML_TYPE_BF16) return -1;
+    const struct ggml_tensor * b = d->src[1];
+    if (b->ne[1] < 2 || b->ne[1] > 8 || b->ne[2] != 1 || b->ne[3] != 1 || d->src[0]->ne[2] != 1 || d->src[0]->ne[3] != 1 ||
+        b->type != GGML_TYPE_F32 || d->type != GGML_TYPE_F32) return -1;
+    // one pass with the stock n = 1 arithmetic: every column converted to the vec_dot type exactly as the stock op does
+    // (elementwise, any split), then each (row, column) is one vec_dot call -- the call the stock n = 1 path makes
+    const struct ggml_tensor * a = d->src[0];
+    const enum ggml_type vt = type_traits_cpu[a->type].vec_dot_type;
+    ggml_from_float_t const from_float = type_traits_cpu[vt].from_float;
+    ggml_vec_dot_t const vec_dot = type_traits_cpu[a->type].vec_dot;
+    const int64_t K = b->ne[0], R = a->ne[1], C = b->ne[1];
+    const size_t rs = ggml_row_size(vt, K), bs = ggml_blck_size(vt);
+    if (type_traits_cpu[a->type].nrows != 1 || !from_float || rs * (size_t) C > params->wsize || K != a->ne[0]) return -1;
+    const int ith = params->ith, nth = params->nth;
+    char * w = (char *) params->wdata;
+    for (int64_t c = 0; c < C; ++c) {
+        const int64_t s0 = (ith * K / (int64_t) bs) / nth, s1 = ((ith + 1) * K / (int64_t) bs) / nth;
+        from_float((const float *) ((const char *) b->data + c * b->nb[1]) + s0 * bs, w + c * rs + s0 * ggml_type_size(vt), (s1 - s0) * bs);
+    }
+    ggml_barrier(params->threadpool);
+    for (int64_t q = ith; q < R * C; q += nth) {
+        const int64_t r = q % R, c = q / R;
+        float v;
+        vec_dot((int) K, &v, 0, (const char *) a->data + r * a->nb[1], 0, w + c * rs, 0, 1);
+        *(float *) ((char *) d->data + c * d->nb[1] + r * d->nb[0]) = v;
+    }
+    return 1;
+}
