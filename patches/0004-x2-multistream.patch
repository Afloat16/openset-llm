+        }
+    }
+    if (!mode) return -1;
+#if defined(GGML_SIMD)
+    if ((mode & 64) && (n->op == GGML_OP_RMS_NORM || n->op == GGML_OP_GLU || n->op == GGML_OP_MUL) && x2o_is_multi(cg, i)) {
+        x2_chain xc;
+        if (x2_chain_match(cg, i, &xc)) { x2_chain_compute(&xc, params); if (dbg) ++x2_dbg_n[xc.k.norm ? 5 : xc.k.glu ? 6 : 7]; return xc.n_nodes; }
+        return -1;
+    }
+#endif
+    switch (n->op) {
+        case GGML_OP_GATED_DELTA_NET: {
+            if (!(mode & 1)) return -1;
+            float * addr = x2_gdn_match(cg, i, NULL);
+            if (!addr) return -1;
+            x2_gdn_compute(n, addr, params);
+            if (dbg) { ++x2_dbg_n[0]; x2_dbg_n[2] += n->src[2]->ne[3]; }
+            return 1;
+        }
+        case GGML_OP_CONCAT: {
+            if (!(mode & 2)) return -1;
+            for (int j = i + 1; j < cg->n_nodes && j <= i + 16; ++j)
+                if (cg->nodes[j]->op == GGML_OP_SSM_CONV) {
+                    x2_conv_m m;
+                    if (x2_conv_match(cg, j, &m) && m.cat == n) { x2_conv_step(&m, params); if (dbg) { ++x2_dbg_n[1]; x2_dbg_n[3] += m.n; } return 1; }
+                    return -1;
+                }
+            return -1;
+        }
+        case GGML_OP_GET_ROWS: {
+            int64_t ng = 0;
+            if (n->ne[1] < 2 || !x2_rows_addr(n, &ng)) return -1;
+            for (int j = i + 1; j < cg->n_nodes && j <= i + 32; ++j) {
+                const ggml_tensor * d = cg->nodes[j];
+                if ((mode & 1) && d->op == GGML_OP_GATED_DELTA_NET && x2_base(d->src[5]) == n) return x2_gdn_match(cg, j, NULL) ? 0 : -1;
+                if ((mode & 2) && d->op == GGML_OP_SSM_CONV) { x2_conv_m m; if (x2_conv_match(cg, j, &m) && m.g == n) return 0; }
+            }
+            return -1;
+        }
+        case GGML_OP_CPY: {
+            const ggml_tensor * b = x2_base(n->src[0]);
+            if ((mode & 1) && b->op == GGML_OP_GATED_DELTA_NET) {
+                const int jd = x2_index_of(cg, b, i - 16, i);
+                const ggml_tensor * cp = NULL;
+                return jd >= 0 && x2_gdn_match(cg, jd, &cp) && cp == n ? 0 : -1;
+            }
+            if ((mode & 2) && b->op == GGML_OP_CONCAT) {
+                for (int j = i + 1; j < cg->n_nodes && j <= i + 16; ++j)
+                    if (cg->nodes[j]->op == GGML_OP_SSM_CONV) { x2_conv_m m; return x2_conv_match(cg, j, &m) && m.cpy == n ? 0 : -1; }
+            }
+            return -1;
+        }
+        case GGML_OP_FLASH_ATTN_EXT: {
+            if (!(mode & 16)) return -1;
+            const int r = x2_fa((ggml_tensor *) n, params);
+            if (dbg && r > 0) ++x2_dbg_n[4];
+            return r;
+        }
+        default: return -1;
+    }
+}
