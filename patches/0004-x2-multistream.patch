+extern "C" int ggml_x2_node(const struct ggml_cgraph * cg, int i, const struct ggml_compute_params * params) {
+    if (x2_mode_v < 0) { const char * e = getenv("GGML_X2"); const char * d = getenv("GGML_X2_DBG"); x2_dbg_v = d && atoi(d); x2_mode_v = e ? atoi(e) : 0; }
+    const int mode = x2_mode_v;
+    if ((!mode && !x2_dbg_v) || params->use_ref) return -1;
+    const ggml_tensor * n = cg->nodes[i];
+    const bool dbg = x2_dbg_v && params->ith == 0;
+    if (dbg) {
+        static bool reg = false; if (!reg) { reg = true; atexit(x2_dbg_dump); }
+        if (n->op == GGML_OP_MUL_MAT && n->src[0]->type == GGML_TYPE_PTQ1_0) {
+            const int64_t m = n->src[1]->ne[1] * n->src[1]->ne[2];
