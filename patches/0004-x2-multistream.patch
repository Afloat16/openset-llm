+    fprintf(stderr, "X2: gdn_inplace %ld (seqs %ld), conv_fused %ld (seqs %ld), fa_per_stream %ld, chains norm %ld glu %ld sign %ld; ptq1 M hist:", x2_dbg_n[0], x2_dbg_n[2], x2_dbg_n[1], x2_dbg_n[3], x2_dbg_n[4], x2_dbg_n[5], x2_dbg_n[6], x2_dbg_n[7]);
+    for (int i = 1; i < 10; ++i) fprintf(stderr, " %s%d=%ld", i == 9 ? ">" : "", i == 9 ? 8 : i, x2_dbg_m[i]);
+    fprintf(stderr, " (3D activations: %ld)\n", x2_dbg_m[0]);
+}
+static const ggml_tensor * x2_base(const ggml_tensor * t) {
+    while (t && t->view_src && (t->op == GGML_OP_RESHAPE || t->op == GGML_OP_VIEW || t->op == GGML_OP_PERMUTE || t->op == GGML_OP_TRANSPOSE)) t = t->view_src;
+    return t;
+}
+static int x2_index_of(const ggml_cgraph * cg, const ggml_tensor * t, int from, int to) {
+    for (int j = from < 0 ? 0 : from; j <= to && j < cg->n_nodes; ++j) if (cg->nodes[j] == t) return j;
+    return -1;
+}
+// a GET_ROWS gathering n >= 2 consecutive f32 rows h..h+n-1 (in order) of a 2D cache: the address of row h, else NULL
+static float * x2_rows_addr(const ggml_tensor * g, int64_t * n_out) {
+    if (!g || g->op != GGML_OP_GET_ROWS || g->type != GGML_TYPE_F32 || g->ne[1] < 2 || g->ne[2] != 1 || g->ne[3] != 1 || !ggml_is_contiguous(g)) return NULL;
+    const ggml_tensor * cache = g->src[0], * idx = g->src[1];
+    if (cache->type != GGML_TYPE_F32 || cache->nb[0] != sizeof(float) || cache->ne[0] != g->ne[0] || cache->ne[2] != 1 || cache->ne[3] != 1 ||
+        cache->nb[1] != (size_t) cache->ne[0] * sizeof(float) || idx->type != GGML_TYPE_I32 || ggml_nelements(idx) != g->ne[1] ||
+        !ggml_is_contiguous(idx) || !cache->data || !idx->data) return NULL;
+    const int32_t * id = (const int32_t *) idx->data;
+    const int64_t n = g->ne[1];
+    if (id[0] < 0 || id[0] + n > cache->ne[1]) return NULL;
+    for (int64_t s = 1; s < n; ++s) if (id[s] != id[0] + s) return NULL;
+    *n_out = n;
+    return (float *) ((char *) cache->data + (size_t) id[0] * cache->nb[1]);
+}
+static bool x2_ovl(const ggml_tensor * a, const ggml_tensor * b) {
+    if (!a || !b || !a->data || !b->data) return false;
+    const char * pa = (const char *) a->data, * pb = (const char *) b->data;
+    return pa < pb + ggml_nbytes(b) && pb < pa + ggml_nbytes(a);
+}
+
+// bit 1: GDN node (K = 1, one token per sequence, n >= 2 sequences, gathered mode) whose state input is the gather of
+// rows h..h+n-1 and whose new states are copied back to those rows -> row h's address (and the CPY), else NULL
+static float * x2_gdn_match(const ggml_cgraph * cg, int i_gdn, const ggml_tensor ** cpy_out) {
+    const ggml_tensor * d = cg->nodes[i_gdn];
+    if (d->op != GGML_OP_GATED_DELTA_NET || d->src[6] || ggml_get_op_params_i32(d, 0) != 1) return NULL;
+    const ggml_tensor * v = d->src[2];
+    if (v->ne[2] != 1 || v->ne[3] < 2) return NULL;
+    const ggml_tensor * g = x2_base(d->src[5]);
+    int64_t n = 0;
+    float * addr = x2_rows_addr(g, &n);
+    if (!addr || n != v->ne[3]) return NULL;
+    const int64_t S_v = v->ne[0], H = v->ne[1];
+    const size_t state_bytes = (size_t) S_v * S_v * H * sizeof(float);
+    if ((size_t) g->ne[0] * sizeof(float) != state_bytes || !ggml_is_contiguous(d->src[5]) || d->src[5]->nb[3] != state_bytes) return NULL;
+    const int ig = x2_index_of(cg, g, i_gdn - 32, i_gdn);
+    if (ig < 0 || ggml_node_get_use_count(cg, ig) != 1) return NULL;
+    if (d->src[5] != g) {
+        const int ir = x2_index_of(cg, d->src[5], ig, i_gdn);
+        if (ir < 0 || ggml_node_get_use_count(cg, ir) != 1) return NULL;
+    }
+    for (int j = i_gdn + 1; j < cg->n_nodes && j <= i_gdn + 16; ++j) {
+        const ggml_tensor * cp = cg->nodes[j];
+        if (cp->op == GGML_OP_CPY && x2_base(cp->src[0]) == d) {
+            const ggml_tensor * sv = cp->src[0];
+            if (cp->type != GGML_TYPE_F32 || cp->data != (void *) addr || !ggml_is_contiguous(cp) || ggml_nbytes(cp) != state_bytes * n ||
+                sv->type != GGML_TYPE_F32 || !ggml_is_contiguous(sv) || sv->view_offs != (size_t) S_v * H * n * sizeof(float)) return NULL;
+            if (cpy_out) *cpy_out = cp;
+            return addr;
+        }
+    }
+    return NULL;
+}
+
+// the GDN step for every (head, sequence), in place on the cache rows; the stock one-chunk body with only the state
+// location changed (K = 1, n_tokens = 1)
+static void x2_gdn_compute(const ggml_tensor * dst, float * state0, const ggml_compute_params * params) {
+    const ggml_tensor * src_q = dst->src[0], * src_k = dst->src[1], * src_v = dst->src[2], * src_g = dst->src[3], * src_beta = dst->src[4];
+    const bool raw_gates = ggml_get_op_params_i32(dst, 1) != 0;
+    const float * raw_dt_bias = raw_gates ? (const float *) dst->src[7]->data : nullptr;
+    const float * raw_a = raw_gates ? (const float *) dst->src[8]->data : nullptr;
+    const int64_t S_v = src_v->ne[0], H = src_v->ne[1], n_seqs = src_v->ne[3];
+    const bool kda = src_g->ne[0] == S_v;
+    const int64_t rq3 = src_v->ne[3] / src_q->ne[3], rk3 = src_v->ne[3] / src_k->ne[3];
+    float * attn_out_base = (float *) dst->data;
+    const float scale = 1.0f / sqrtf((float) S_v);
+    float * delta = (float *) params->wdata + params->ith * S_v + CACHE_LINE_SIZE_F32;   // the stock op's scratch (K = 1)
+    // dynamic chunks of 2 (head, sequence) rows: the rows are independent, so any assignment gives the same values
+    if (params->ith == 0) ggml_threadpool_chunk_set(params->threadpool, params->nth);
+    ggml_barrier(params->threadpool);
+    const int64_t nrow = H * n_seqs, dr = 2, nch = (nrow + dr - 1) / dr;
+    for (int64_t c = params->ith; c < nch; c = ggml_threadpool_chunk_add(params->threadpool, 1))
+    for (int64_t ir = c * dr; ir < std::min(nrow, (c + 1) * dr); ++ir) {
+        const int64_t iv1 = ir % H, iv3 = ir / H;
+        const int64_t iq1 = iv1 % src_q->ne[1], ik1 = iv1 % src_k->ne[1], iq3 = iv3 / rq3, ik3 = iv3 / rk3;
+        float * s_out = state0 + (iv3 * H + iv1) * S_v * S_v;
+        float * attn_data = attn_out_base + (iv3 * H + iv1) * S_v;
+        const float * q_d = (const float *) ((const char *) src_q->data + iq3 * src_q->nb[3] + iq1 * src_q->nb[1]);
+        const float * k_d = (const float *) ((const char *) src_k->data + ik3 * src_k->nb[3] + ik1 * src_k->nb[1]);
+        const float * v_d = (const float *) ((const char *) src_v->data + iv3 * src_v->nb[3] + iv1 * src_v->nb[1]);
+        float beta_val = *(const float *) ((const char *) src_beta->data + iv3 * src_beta->nb[3] + iv1 * src_beta->nb[1]);
+        const float * g_d = (const float *) ((const char *) src_g->data + iv3 * src_g->nb[3] + iv1 * src_g->nb[1]);
+        float g0 = g_d[0];
+        if (raw_gates) {
+            beta_val = 1.0f / (1.0f + expf(-beta_val));
+            const float x = g0 + raw_dt_bias[iv1];
+            g0 = raw_a[iv1] * ((x > 20.0f) ? x : logf(1.0f + expf(x)));
+        }
+        if (kda) {
+            for (int64_t i = 0; i < S_v; ++i) delta[i] = expf(g_d[i]);
+            for (int64_t j = 0; j < S_v; ++j) ggml_vec_mul_f32(S_v, &s_out[j * S_v], &s_out[j * S_v], delta);
+        } else {
+            ggml_vec_scale_f32(S_v * S_v, s_out, expf(g0));
+        }
+        for (int64_t j = 0; j < S_v; ++j) { float sum = 0.0f; ggml_vec_dot_f32(S_v, &sum, 0, &s_out[j * S_v], 0, k_d, 0, 1); delta[j] = (v_d[j] - sum) * beta_val; }
+        for (int64_t j = 0; j < S_v; ++j) ggml_vec_mad_f32(S_v, &s_out[j * S_v], k_d, delta[j]);
+        for (int64_t j = 0; j < S_v; ++j) { float sum = 0.0f; ggml_vec_dot_f32(S_v, &sum, 0, &s_out[j * S_v], 0, q_d, 0, 1); attn_data[j] = sum * scale; }
+    }
+}
+
+// bit 2: SSM_CONV node i_s (one token per sequence, n >= 2) over CONCAT(reshaped gather of 3-column rows h..h+n-1, the
+// new column) with the CPY of the last three columns back to those rows
+struct x2_conv_m { float * addr; const ggml_tensor * g, * cat, * cpy, * xs; int64_t n; };
+static bool x2_conv_match(const ggml_cgraph * cg, int i_s, x2_conv_m * m) {
+    const ggml_tensor * s = cg->nodes[i_s];
+    if (s->op != GGML_OP_SSM_CONV || s->type != GGML_TYPE_F32 || s->ne[1] != 1 || s->ne[2] < 2) return false;
+    const ggml_tensor * cat = s->src[0], * w = s->src[1];
+    const int64_t nr = s->ne[0], n = s->ne[2];
+    if (cat->op != GGML_OP_CONCAT || cat->type != GGML_TYPE_F32 || ggml_get_op_params_i32(cat, 0) != 0 || cat->ne[0] != 4 || cat->ne[1] != nr ||
+        cat->ne[2] != n || cat->ne[3] != 1 || !ggml_is_contiguous(cat) || w->type != GGML_TYPE_F32 || w->ne[0] != 4 || w->ne[1] != nr) return false;
+    const ggml_tensor * st = cat->src[0], * xs = cat->src[1];
+    if (st->type != GGML_TYPE_F32 || st->ne[0] != 3 || st->ne[1] != nr || st->ne[2] != n || !ggml_is_contiguous(st) ||
+        xs->type != GGML_TYPE_F32 || xs->ne[0] != 1 || xs->ne[1] != nr || xs->ne[2] != n || xs->nb[1] != sizeof(float) || !xs->data) return false;
+    const ggml_tensor * g = x2_base(st);
+    int64_t ng = 0;
+    float * addr = x2_rows_addr(g, &ng);
+    if (!addr || ng != n || g->ne[0] != 3 * nr) return false;
+    const int ig = x2_index_of(cg, g, i_s - 32, i_s);
+    const int ic = x2_index_of(cg, cat, ig < 0 ? 0 : ig, i_s);
+    if (ig < 0 || ic < 0 || ggml_node_get_use_count(cg, ig) != 1 || ggml_node_get_use_count(cg, ic) != 2) return false;
+    if (st != g) { const int ir = x2_index_of(cg, st, ig, ic); if (ir < 0 || ggml_node_get_use_count(cg, ir) != 1) return false; }
+    const ggml_tensor * cpy = NULL;
+    for (int j = ic + 1; j < cg->n_nodes && j <= i_s + 1; ++j) {
+        const ggml_tensor * nd = cg->nodes[j];
+        if (nd->op == GGML_OP_CPY && x2_base(nd->src[0]) == cat) {
+            const ggml_tensor * vw = nd->src[0];
+            if (vw->view_offs != sizeof(float) || vw->ne[0] != 3 || vw->ne[1] != nr || vw->ne[2] != n || vw->nb[0] != sizeof(float) ||
+                vw->nb[1] != 4 * sizeof(float) || vw->nb[2] != cat->nb[2] || nd->type != GGML_TYPE_F32 || nd->data != (void *) addr ||
+                !ggml_is_contiguous(nd) || ggml_nbytes(nd) != (size_t) 3 * nr * n * sizeof(float)) return false;
+            cpy = nd;
+        }
+    }
+    if (!cpy || x2_ovl(cat, xs) || x2_ovl(cat, g->src[0])) return false;
+    m->addr = addr; m->g = g; m->cat = cat; m->cpy = cpy; m->xs = xs; m->n = n;
+    return true;
+}
+// conv input (seq s, row r) = (state row, x[s][r]); state row <- (s1, s2, x) in place; any split gives the same bytes
+static void x2_conv_step(const x2_conv_m * m, const ggml_compute_params * params) {
+    const int64_t nr = m->cat->ne[1], tot = nr * m->n, dr = (tot + params->nth - 1) / params->nth;
+    const int64_t r0 = MIN(dr * params->ith, tot), r1 = MIN(r0 + dr, tot);
+    float * st = m->addr, * ci = (float *) m->cat->data;
+    int64_t s = r0 / nr, r = r0 % nr;   // walked incrementally (no division per row)
+    for (int64_t q = r0; q < r1; ++q, ++r) {
+        if (r == nr) { r = 0; ++s; }
+        const float xr = *(const float *) ((const char *) m->xs->data + s * m->xs->nb[2] + r * sizeof(float));
+        float * row = st + q * 3;   // rows are contiguous: seq s row r at (s * nr + r) * 3
+        float * c4 = (float *) ((char *) ci + s * m->cat->nb[2]) + 4 * r;
+        const float a = row[0], b = row[1], c = row[2];
+        c4[0] = a; c4[1] = b; c4[2] = c; c4[3] = xr;
+        row[0] = b; row[1] = c; row[2] = xr;
+    }
+}
+
+// bit 16: FLASH_ATTN_EXT over n_stream >= 2 per-sequence KV streams, one query token per stream (decode). The stock op
+// takes the one-chunk path for every (head, stream) over the common n_kv (max over streams), while one stream alone takes
+// the split-KV path once its n_kv >= 512 (different float order). Here each stream runs as its own op call, with the
+// n_kv the cache would give it alone (its last visible cell + 1, padded to 256 like llama_kv_cache::get_n_kv), so the
+// dispatch and the KV chunk bounds are the single-stream ones.
+static int x2_fa(ggml_tensor * d, const ggml_compute_params * params) {
+    const ggml_tensor * q = d->src[0], * k = d->src[1], * v = d->src[2], * m = d->src[3];
+    if (!m || q->ne[1] != 1 || q->ne[3] < 2 || k->ne[3] != q->ne[3] || v->ne[3] != q->ne[3] || m->ne[3] != q->ne[3] ||
+        m->type != GGML_TYPE_F16 || m->ne[2] != 1 || d->ne[3] != q->ne[3] || (d->src[4] && d->src[4]->ne[3] > 1)) return -1;
+    const int64_t ns = q->ne[3], nkv = k->ne[1];
+    for (int64_t s = 0; s < ns; ++s) {
+        const ggml_fp16_t * mr = (const ggml_fp16_t *) ((const char *) m->data + s * m->nb[3]);   // row of query 0
+        int64_t last = -1;
+        for (int64_t c = nkv - 1; c >= 0; --c) if (GGML_CPU_FP16_TO_FP32(mr[c]) != -INFINITY) { last = c; break; }
+        const int64_t nk = std::min<int64_t>(nkv, std::max<int64_t>(256, (last + 1 + 255) / 256 * 256));
+        ggml_tensor q2 = *q, k2 = *k, v2 = *v, m2 = *m, d2 = *d;
+        q2.ne[3] = 1; q2.data = (char *) q->data + s * q->nb[3];
+        k2.ne[3] = 1; k2.ne[1] = nk; k2.data = (char *) k->data + s * k->nb[3];
+        v2.ne[3] = 1; v2.ne[1] = nk; v2.data = (char *) v->data + s * v->nb[3];
+        m2.ne[3] = 1; m2.ne[0] = nk; m2.data = (char *) m->data + s * m->nb[3];
+        d2.ne[3] = 1; d2.data = (char *) d->data + s * d->nb[3];
+        d2.src[0] = &q2; d2.src[1] = &k2; d2.src[2] = &v2; d2.src[3] = &m2;
+        if (s > 0) ggml_barrier(params->threadpool);   // the op's chunk counter / partials are reused by the next call
+        ggml_compute_forward_flash_attn_ext(params, &d2);
+    }
+    return 1;
+}
+
+// bit 64: the one-row chains K6 fuses (bits 16/32/64), on the n = 2..8 rows of a multi-sequence decode step:
+// [RMS_NORM, MUL(w), MUL(sign), RESHAPE, FWHT], [GLU(swiglu), MUL(sign), RESHAPE, FWHT], [MUL(sign), RESHAPE, FWHT].
+// Each (row, 1024-block) unit is computed with K6's arithmetic (x * scale * w, the stock sequential double sum of
+// squares per row, ggml_vec_swiglu_f32 / ggml_vec_mul_f32 per block, k6_fwht_row), i.e. what a single stream computes
+// alone with K6 on; units are split in contiguous ranges, a thread computing the sum of squares of each row it touches.
+// Only in multi-sequence one-token-per-sequence graphs (a prefill tail of a few tokens alone runs the stock ops).
+static thread_local const ggml_cgraph * x2o_cg; static thread_local int x2o_last = 1 << 30, x2o_multi;
+static bool x2o_is_multi(const ggml_cgraph * cg, int i) {
+    if (cg != x2o_cg || i < x2o_last) {
+        x2o_multi = 0;
+        for (int j = 0; j < cg->n_nodes; ++j) {
+            const ggml_tensor * g = cg->nodes[j];
+            if (g->op == GGML_OP_GATED_DELTA_NET) { x2o_multi = g->src[2]->ne[2] == 1 && g->src[2]->ne[3] >= 2; break; }
+        }
+    }
+    x2o_cg = cg; x2o_last = i;
+    return x2o_multi;
+}
+#if defined(GGML_SIMD)
+static bool x2_rows(const ggml_tensor * t, int64_t D, int64_t n) {
+    return t->type == GGML_TYPE_F32 && t->ne[0] == D && ggml_nelements(t) == D * n && ggml_is_contiguous(t);
+}
+struct x2_chain { int n_nodes; int64_t rows; k6_chain k; };
+static bool x2_chain_match(const ggml_cgraph * cg, int i, x2_chain * xc) {
+    const ggml_tensor * n0 = cg->nodes[i];
+    k6_chain * ch = &xc->k;
+    int j = i;
+    ch->norm = ch->glu = NULL; ch->mulw = NULL;
+    const int64_t D = n0->ne[0];
+    if (D <= 0 || ggml_nelements(n0) % D) return false;
+    const int64_t n = ggml_nelements(n0) / D;
+    if (n < 2 || n > 8) return false;
+    if (n0->op == GGML_OP_RMS_NORM) {
+        if (!x2_rows(n0, D, n) || !x2_rows(n0->src[0], D, n) || ggml_node_get_use_count(cg, i) != 1 || j + 1 >= cg->n_nodes) return false;
+        const ggml_tensor * m = cg->nodes[++j];
+        if (m->op != GGML_OP_MUL || m->src[0] != n0 || !x2_rows(m, D, n) || !k6_row1(m->src[1], D)) return false;
+        ch->norm = n0; ch->mulw = m;
+    } else if (n0->op == GGML_OP_GLU) {
+        if (ggml_get_glu_op(n0) != GGML_GLU_OP_SWIGLU || !n0->src[1] || !x2_rows(n0, D, n) || !x2_rows(n0->src[0], D, n) || !x2_rows(n0->src[1], D, n)) return false;
+        ch->glu = n0; ch->mulw = n0;
+    } else if (n0->op == GGML_OP_MUL) {
+        if (!x2_rows(n0, D, n) || !x2_rows(n0->src[0], D, n)) return false;
+        ch->mulw = n0->src[0]; j = i - 1;
+    } else return false;
+    if (j + 3 >= cg->n_nodes) return false;
+    const ggml_tensor * sg = cg->nodes[++j];
+    if (sg->op != GGML_OP_MUL || sg->src[0] != ch->mulw || !x2_rows(sg, D, n) || !k6_row1(sg->src[1], D)) return false;
+    const ggml_tensor * r = cg->nodes[++j];
+    if (r->op != GGML_OP_RESHAPE || r->view_src != sg) return false;
+    const ggml_tensor * h = cg->nodes[++j];
+    if (h->op != GGML_OP_MUL_MAT || ggml_get_op_params_i32(h, 1) != GGML_HINT_SRC0_IS_HADAMARD || h->src[1] != r || h->src[0]->type != GGML_TYPE_F32 ||
+        h->type != GGML_TYPE_F32 || !ggml_is_contiguous(h) || ggml_nelements(h) != D * n) return false;
+    const int64_t hn = h->src[0]->ne[0];
+    if (hn < 16 || (hn & (hn - 1)) || r->ne[0] != hn || h->ne[0] != hn || D % hn != 0 || !k6_step_ok(hn)) return false;
+    ch->muls = sg; ch->fwht = h; ch->hn = hn; ch->D = D; ch->n = j - i + 1;
+    {   // the K7 rule, as in k6_chain_match
+        const ggml_tensor * outs[3] = { ch->mulw, sg, h };
+        if (ch->norm) { const ggml_tensor * ins[3] = { ch->norm->src[0], ch->mulw->src[1], sg->src[1] }; const bool ok[3] = { false, false, false };
+                        if (!k6_disjoint(outs, 3, ins, ok, 3)) return false; }
+        else if (ch->glu) { const ggml_tensor * ins[3] = { ch->glu->src[0], ch->glu->src[1], sg->src[1] }; const bool ok[3] = { true, true, false };
+                            if (!k6_disjoint(outs, 3, ins, ok, 3)) return false; }
+        else { const ggml_tensor * outs2[2] = { sg, h }; const ggml_tensor * ins[2] = { ch->mulw, sg->src[1] }; const bool ok[2] = { true, false };
+               if (!k6_disjoint(outs2, 2, ins, ok, 2)) return false; }
+    }
+    xc->rows = n; xc->n_nodes = ch->n;
+    return true;
+}
+static void x2_chain_compute(const x2_chain * xc, const ggml_compute_params * params) {
+    const k6_chain * ch = &xc->k;
+    const int64_t D = ch->D, hn = ch->hn, nblk = D / hn, U = xc->rows * nblk;
+    const int64_t u0 = U * params->ith / params->nth, u1 = U * (params->ith + 1) / params->nth;
+    const float * x = ch->norm ? (const float *) ch->norm->src[0]->data : NULL;
+    const float * w = ch->norm ? (const float *) ch->mulw->src[1]->data : NULL;
+    float eps = 0.0f; if (ch->norm) memcpy(&eps, ch->norm->op_params, sizeof(float));
+    float * y1 = (float *) ch->mulw->data, * y2 = (float *) ch->muls->data, * out = (float *) ch->fwht->data;
+    const float * sg = (const float *) ch->muls->src[1]->data;
+    const float fscale = 1.0f / sqrtf((float) hn);
+    int64_t row_done = -1; float scale = 0.0f;
+    for (int64_t u = u0; u < u1; ++u) {
+        const int64_t row = u / nblk, b = u % nblk, o = row * D + b * hn;
+        if (ch->norm && row != row_done) {   // the stock sequential double sum of this row
+            const float * xr = x + row * D;
+            ggml_float sum = 0.0;
+            for (int64_t q = 0; q < D; q++) sum += (ggml_float)(xr[q] * xr[q]);
+            const float mean = sum / D;
+            scale = 1.0f / sqrtf(mean + eps); row_done = row;
+        }
+        if (ch->norm) {
+            for (int64_t q = 0; q < hn; q++) y1[o + q] = x[o + q] * scale * w[b * hn + q];
+        } else if (ch->glu) {
+            ggml_vec_swiglu_f32((int) hn, y1 + o, (const float *) ch->glu->src[0]->data + o, (const float *) ch->glu->src[1]->data + o);
+        }
+        ggml_vec_mul_f32((int) hn, y2 + o, y1 + o, sg + b * hn);
+        k6_fwht_row(y2 + o, out + o, hn, fscale);
+    }
+}
