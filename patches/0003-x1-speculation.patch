+#include "ggml-cpu.h"
+#include <fstream>
+#include <algorithm>
+static ggml_tensor * x1_dh = nullptr, * x1_dh_ids = nullptr;
+// fallback (X1_DRAFT_FALLBACK, read by the server): token -> in the draft list, and the full-vocab switch the server sets
+// per draft call when recent text is mostly outside the list. The switch only picks which head drafts; verify decides.
+static std::vector<char> x1_dh_member;
+static int x1_dh_full_v = 0;
+extern "C" LLAMA_API int  llama_x1_draft_list_ready(void)     { return x1_dh != nullptr; }
+extern "C" LLAMA_API int  llama_x1_draft_list_has(int32_t t)  { return t >= 0 && (size_t) t < x1_dh_member.size() && x1_dh_member[t]; }
+extern "C" LLAMA_API void llama_x1_draft_set_full(int full)   { x1_dh_full_v = full ? 1 : 0; }
+extern "C" LLAMA_API int  llama_x1_draft_full(void)           { return x1_dh_full_v; }
+static void x1_dh_init(const ggml_tensor * out, const llama_hadamard_rotations * rot) {
+    static bool done = false;
+    if (done) return;
+    const char * e = getenv("X1_DRAFT_VOCAB");
+    if (!e || atoll(e) <= 0) { done = true; return; }
+    // the model can be built without data first (memory fitting / reserve): only copy from real, host-resident weights
+    if (!out || !out->data || !out->buffer || !ggml_backend_buffer_is_host(out->buffer) || ggml_backend_buffer_get_size(out->buffer) == 0) return;
+    done = true;
+    const int64_t n_voc = out->ne[1];
+    const int64_t N = std::min<int64_t>(atoll(e), n_voc);
+    std::vector<int32_t> ids;
+    if (const char * f = getenv("X1_DRAFT_IDS")) {
+        std::ifstream in(f); std::vector<char> seen(n_voc, 0); long long t;
+        while ((int64_t) ids.size() < N && in >> t) if (t >= 0 && t < n_voc && !seen[t]) { seen[t] = 1; ids.push_back((int32_t) t); }
+        for (int64_t t2 = 0; (int64_t) ids.size() < N && t2 < n_voc; ++t2) if (!seen[t2]) { seen[t2] = 1; ids.push_back((int32_t) t2); }
+        std::sort(ids.begin(), ids.end());
+    } else {
+        for (int64_t t = 0; t < N; ++t) ids.push_back((int32_t) t);
+    }
+    ggml_init_params ip = { 4 * ggml_tensor_overhead(), nullptr, true };
+    ggml_context * ctx = ggml_init(ip);
+    x1_dh     = ggml_new_tensor_2d(ctx, out->type, out->ne[0], N);
+    x1_dh_ids = ggml_new_tensor_1d(ctx, GGML_TYPE_I32, N);
+    ggml_set_name(x1_dh, "x1_draft_head");
+    if (!ggml_backend_alloc_ctx_tensors_from_buft(ctx, ggml_backend_cpu_buffer_type())) { x1_dh = x1_dh_ids = nullptr; return; }
+    for (int64_t i = 0; i < N; ++i) memcpy((char *) x1_dh->data + i * x1_dh->nb[1], (const char *) out->data + (int64_t) ids[i] * out->nb[1], out->nb[1]);
+    memcpy(x1_dh_ids->data, ids.data(), N * sizeof(int32_t));
+    x1_dh_member.assign(n_voc, 0);
+    for (const int32_t t : ids) x1_dh_member[t] = 1;
+    if (rot) {   // the full head's input transform applies to its rows unchanged
+        auto * r = const_cast<llama_hadamard_rotations *>(rot);
+        auto it = r->find(out);
+        if (it != r->end()) { const auto tr = it->second; (*r)[x1_dh] = tr; }
+    }
+    LLAMA_LOG_INFO("X1: draft head over %lld of %lld tokens (%s), %.1f MiB\n", (long long) N, (long long) n_voc,
+                   getenv("X1_DRAFT_IDS") ? "id file" : "ids 0..N-1", ggml_nbytes(x1_dh) / 1048576.0);
+}
