+            best = dmax; bestv = V[dmax];
+            for (int d = dmin; d < dmax; ++d) if (V[d] > V[dmax] * (1 + hyst) && V[d] > bestv) { bestv = V[d]; best = d; }
+        } else {
+            for (int d = dmin; d <= dmax; ++d) if (bestv < 0 || V[d] > bestv * (1 + hyst)) { bestv = V[d]; best = d; }   // hysteresis toward shallower depths
+        }
+        const int ex = adapt_explore();
+        if (ex > 0) {   // exploration keeps the neighbours' time estimates fresh
+            if (adapt_steps % ex == ex / 2 && best + 1 <= dmax)  best = best + 1;
+            else if (adapt_steps % ex == 0 && best - 1 >= dmin) best = best - 1;
+        }
+        adapt_cnt[best]++;
+        return best;
+    }
