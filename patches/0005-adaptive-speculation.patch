+    static int    adapt_dmin()   { static int    v = [] { const char * e = getenv("LLAMA_SPEC_ADAPT_MIN");   return e ? atoi(e) : 0;    }(); return v; }
+    static int    adapt_log()    { static int    v = [] { const char * e = getenv("LLAMA_SPEC_ADAPT_LOG");   return e ? atoi(e) : 0;    }(); return v; }
+    static double adapt_hyst()   { static double v = [] { const char * e = getenv("LLAMA_SPEC_ADAPT_HYST");  return e ? atof(e) : 0.02; }(); return v; }   // relative gain needed to leave the anchor / shallower depth
+    static int    adapt_explore(){ static int    v = [] { const char * e = getenv("LLAMA_SPEC_ADAPT_EXPLORE"); return e ? atoi(e) : 16; }(); return v; }  // try a neighbour every N steps (0 = never)
+    static int    adapt_anchor() { static int    v = [] { const char * e = getenv("LLAMA_SPEC_ADAPT_ANCHOR"); return e ? atoi(e) : 0;   }(); return v; }   // 1: stay at the max depth unless another depth beats it by HYST
+
+    void adapt_reset() {
+        if (adapt_log() && adapt_steps > 0) {
+            fprintf(stderr, "ADAPT slot %d: %d steps, depth counts", id, adapt_steps);
+            for (int d = 0; d <= 8; ++d) if (adapt_cnt[d]) fprintf(stderr, " d%d=%d", d, adapt_cnt[d]);
+            fprintf(stderr, "; ms/step");
+            for (int d = 0; d <= 8; ++d) if (adapt_n[d]) fprintf(stderr, " d%d=%.1f", d, adapt_ms[d]);
+            fprintf(stderr, "\n");
+        }
+        adapt_d_step = -1; adapt_t_step = 0; adapt_steps = 0; adapt_hist.clear();
+        for (int i = 0; i < 9; ++i) { adapt_ms[i] = 0; adapt_n[i] = 0; adapt_cnt[i] = 0; }
+    }
+
+    // outcome of the step in flight: d tokens were drafted (0 = plain), a of them accepted
+    void adapt_record(int d, int a) {
+        if (adapt_d_step < 0) return;
+        const double ms = (double) (ggml_time_us() - adapt_t_step) * 1e-3;
+        const int di = d < 8 ? d : 8;
+        adapt_ms[di] = adapt_n[di] == 0 ? ms : 0.8 * adapt_ms[di] + 0.2 * ms;
+        adapt_n[di]++;
+        if (d > 0) {
+            adapt_hist.emplace_back((uint8_t) d, (uint8_t) a);
+            if ((int) adapt_hist.size() > adapt_window()) adapt_hist.erase(adapt_hist.begin());
+        }
+        adapt_d_step = -1;
+    }
+
+    int adapt_choose() {
+        const int dmax = std::min(adapt_dmax, 8);
+        const int dmin = std::min(adapt_dmin(), dmax);
+        adapt_steps++;
+        double q[8];
+        for (int i = 0; i < dmax; ++i) {
+            double acc = 1.2, tri = 2.0;   // Beta prior: mean 0.6, weight 2
+            for (const auto & h : adapt_hist) if (h.first > i && h.second >= i) { tri += 1; if (h.second > i) acc += 1; }
+            q[i] = acc / tri;
+        }
